            max-width: 700px;
            text-align: center;
            color: #fff;
            padding: 15px 0;
            font-size: 1.1rem;
            font-weight: 600;
        }
        .close-modal {
            position: absolute;
            top: 20px;
            right: 30px;
            color: #fff;
            font-size: 35px;
            font-weight: bold;
            cursor: pointer;
            transition: color 0.2s;
        }
        .close-modal:hover {
            color: var(--accent-color);
        }

        @keyframes zoomAnimation {
            from { transform: scale(0.7); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
