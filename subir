    <style>
        :root {
            --primary-color: #2c3e50;
            --accent-color: #e74c3c;
            --bg-color: #f3f8f4;
            --cat-active: #8e44ad;
            --success-color: #27ae60;
            --danger-color: #c0392b;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: #333;
        }
        header {
            background-color: var(--primary-color);
            color: white;
            text-align: center;
            padding: 2rem 1rem;
        }
        header h1 {
            margin: 0;
            font-size: 2.2rem;
        }
        header p {
            margin: 0.5rem 0 0;
            color: #bdc3c7;
        }
        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }
        
        /* BUSCADOR */
        .search-box {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .search-box input {
            width: 100%;
            max-width: 400px;
            padding: 0.75rem 1rem;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 25px;
            outline: none;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        /* CATEGORÍAS E ÍCONOS */
        .categories-container {
            display: flex;
            justify-content: center;
            gap: 0.8rem;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }
        .category-btn {
            background-color: #fff;
            border: 2px solid #ddd;
            padding: 0.6rem 1.2rem;
            border-radius: 25px;
            cursor: pointer;
            font-size: 0.95rem;
            font-weight: 600;
            color: #555;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }
        .category-btn i {
            font-size: 1.1rem;
        }
        .category-btn:hover, .category-btn.active {
            background-color: var(--cat-active);
            color: white;
            border-color: var(--cat-active);
            box-shadow: 0 4px 10px rgba(142, 68, 173, 0.25);
        }

        /* GRID DE PRODUCTOS */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }
        .card {
            background: rgba(252, 249, 251, 0.9);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .card:hover {
            transform: translateY(-5px);
        }

        /* CONTENEDOR DE IMAGEN CON LUPA OVERLAY */
        .card-img-wrapper {
            position: relative;
            overflow: hidden;
            cursor: pointer;
            background-color: #ffffff;
        }
        .card-img-wrapper img.zoomable {
            width: 100%;
            height: 250px;
            object-fit: contain;
            padding: 10px;
            box-sizing: border-box;
            display: block;
            transition: transform 0.3s ease;
        }
        .card-img-wrapper:hover img.zoomable {
            transform: scale(1.05);
        }
        .zoom-overlay {
            position: absolute;
            top: 10px;
            right: 10px;
            background-color: rgba(44, 62, 80, 0.7);
            color: white;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0.8;
            transition: opacity 0.3s, background-color 0.3s;
        }
        .card-img-wrapper:hover .zoom-overlay {
            opacity: 1;
            background-color: var(--cat-active);
        }

        .card-content {
            padding: 1.2rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        
        /* TAGS Y ESTADO STOCK */
        .card-header-tags {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.8rem;
        }
        .card-badge {
            background-color: #eee;
            color: #666;
            font-size: 0.75rem;
            padding: 0.25rem 0.6rem;
            border-radius: 12px;
            text-transform: uppercase;
            font-weight: bold;
        }
        .stock-badge {
            font-size: 0.8rem;
            padding: 0.3rem 0.8rem;
            border-radius: 12px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }
        .stock-badge.available {
            background-color: #e8f8f0;
            color: var(--success-color);
        }
        .stock-badge.unavailable {
            background-color: #fdeaea;
            color: var(--danger-color);
        }

        .card-title {
            font-size: 1.2rem;
            margin: 0.3rem 0;
            color: var(--primary-color);
        }
        .card-description {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 0.6rem;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
            padding-top: 1rem;
        }
        .price {
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--accent-color);
        }
        .btn-whatsapp {
            background-color: #25d366;
            color: white;
            padding: 0.5rem 0.9rem;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            font-size: 0.85rem;
            transition: background 0.2s;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        .btn-whatsapp:hover {
            background-color: #1ebe5d;
        }

        footer {
